[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://lapwing.org/misc/webthings/gateway/
MatchPattern=webthings-gateway_@v_%a.usr-%a-verity-sig.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=webthings-gw_@v_verity_sig
MatchPartitionType=usr-verity-sig
PartitionFlags=0
ReadOnly=1
